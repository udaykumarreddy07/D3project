{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Start Web Server (backend/server.js)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/server.js",
            "restart": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Chrome (localhost:3000)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend"
        },
        {
            "name": "Run Academic Audit (report.js)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/backend/report.js",
            "console": "integratedTerminal"
        }
    ]
}
