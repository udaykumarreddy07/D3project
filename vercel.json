{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "database/**"
    }
  },
  "rewrites": [
    {
      "source": "/presentation",
      "destination": "/presentation/index.html"
    },
    {
      "source": "/hardcopy",
      "destination": "/hardcopy.html"
    },
    {
      "source": "/uday",
      "destination": "/uday.html"
    }
  ]
}
