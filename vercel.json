{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/presentation/?",
      "destination": "/frontend/presentation/index.html"
    },
    {
      "source": "/presentation/:path*",
      "destination": "/frontend/presentation/:path*"
    },
    {
      "source": "/hardcopy/?",
      "destination": "/frontend/hardcopy.html"
    },
    {
      "source": "/uday/?",
      "destination": "/frontend/uday.html"
    },
    {
      "source": "/standalone/?",
      "destination": "/frontend/uday.html"
    }
  ]
}
