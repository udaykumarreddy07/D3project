{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/presentation/?",
      "destination": "/presentation/index.html"
    },
    {
      "source": "/presentation/:path*",
      "destination": "/presentation/:path*"
    },
    {
      "source": "/hardcopy/?",
      "destination": "/hardcopy.html"
    },
    {
      "source": "/uday/?",
      "destination": "/uday.html"
    },
    {
      "source": "/standalone/?",
      "destination": "/uday.html"
    }
  ]
}
